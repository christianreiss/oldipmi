# Copy to .env -- never commit the real one.
#
# All three BMC_* are optional. Set them and the container connects at boot; leave them
# empty and it comes up on the connect page, where you can drop a .jnlp or type
# credentials instead.
BMC_HOST=lab-ami.example.net
BMC_USER=ADMIN
BMC_PASS=
# Optional: HTTP basic auth (user 'kvm') covering the connect page, the API, noVNC and
# the WebSocket. Worth setting -- BMC credentials get typed into this port.
WEB_PASSWORD=
# Optional: password for the noVNC/x11vnc layer itself.
VNC_PASSWORD=
SCREEN_GEOMETRY=1280x1024x24
