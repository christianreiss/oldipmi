#!/usr/bin/env python3
"""
Resolve an AMI/Supermicro JViewer JNLP into a running java process.

Two ways in:
  --jnlp FILE|URL     use a JNLP you already have (token inside is single-use/short-lived)
  --host/--user/--pass  log into the BMC and mint a fresh one

We never use javaws. The JARs are signed with a Supermicro cert that expired long ago,
so any Web Start implementation refuses them; `java -cp` ignores signatures entirely.
"""
import argparse, http.client, os, re, shutil, ssl, subprocess, sys, tempfile, zipfile
from urllib.parse import urljoin, urlparse
from xml.etree import ElementTree

import requests
import urllib3

MAIN_CLASS = "com.ami.kvm.jviewer.JViewer"
# Linux x86_64 only -- that is what the container is.
NATIVE_ARCHES = {"x86_64", "amd64"}


def log(msg):
    print(f"[jviewer] {msg}", file=sys.stderr, flush=True)


def bmc_session():
    """Legacy BMC certificates are often expired, self-signed or incomplete."""
    session = requests.Session()
    session.verify = False
    urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)
    return session


# --------------------------------------------------------------------------- login

def bmc_login(host, user, password, timeout=20):
    """Supermicro MegaRAC: POST /rpc/WEBSES/create.asp -> SessionCookie.

    The response is JavaScript, not JSON -- it assigns a WEBVAR_JSONVAR_WEB_SESSION
    literal that the login page then reads. We regex the cookie out of it.
    """
    base = f"http://{host}"
    s = bmc_session()
    try:
        r = s.post(
            f"{base}/rpc/WEBSES/create.asp",
            data={"WEBVAR_USERNAME": user, "WEBVAR_PASSWORD": password},
            timeout=timeout,
        )
        r.raise_for_status()
    except requests.RequestException as e:
        raise SystemExit(f"cannot reach the BMC at {host}: {e}")
    body = r.text

    status = re.search(r"'?HAPI_STATUS'?\s*:\s*(-?\d+)", body)
    if status and status.group(1) != "0":
        raise SystemExit(f"BMC rejected login (HAPI_STATUS={status.group(1)}) -- check user/password")

    m = re.search(r"'?SESSION_COOKIE'?\s*:\s*'([^']+)'", body)
    if not m:
        # The body carries the session cookie when it parses, so it is not safe to
        # surface anywhere but the operator's own logs.
        hint = (f"\n--- response ---\n{body[:600]}" if os.environ.get("JVIEWER_DEBUG")
                else "\nSet JVIEWER_DEBUG=1 to dump the response to stderr.")
        raise SystemExit(
            "login succeeded but no SESSION_COOKIE in response; firmware may differ." + hint
        )
    cookie = m.group(1)
    s.cookies.set("SessionCookie", cookie, path="/")
    s.cookies.set("Username", user, path="/")
    log(f"logged in to {host} as {user}")

    # The web UI greys out the console button unless CURPRIV is Administrator(4)
    # or Operator(3). The JNLP fetch fails opaquely for lesser roles, so say why.
    try:
        role = s.get(f"{base}/rpc/getrole.asp", timeout=10).text
        pr = re.search(r"'?CURPRIV'?\s*:\s*'?(\d+)", role)
        if pr and pr.group(1) not in ("3", "4"):
            log(f"WARNING: {user} has CURPRIV={pr.group(1)}; iKVM needs Operator(3) or Administrator(4)")
    except requests.RequestException:
        pass
    return s, base


# Confirmed against this firmware: /impl/remote_control_imp.js does
#     doLaunchJava = function() { window.open('/Java/jviewer.jnlp', ...) }
# i.e. a plain GET carrying the session cookie. The rest are fallbacks for other
# MegaRAC generations. If yours differs, read your own remote_control_imp.js --
# /impl/ is served without a session, so you can fetch it before logging in.
JNLP_CANDIDATES = [
    "/Java/jviewer.jnlp",
    "/cgi/url_redirect.cgi?url_name=man_ikvm&url_type=jwsk",
    "/jviewer.jnlp",
    "/cgi/jviewer.jnlp",
    "/page/jviewer.jnlp",
]


def tolerant_get(session, url, timeout=20):
    """GET that keeps a body the server cut short.

    This firmware serves the JNLP with `Content-length: 3757` and then sends 2034 bytes
    and closes -- the XML is complete, the header is a lie. urllib3 calls that a broken
    stream and throws the body away (its IncompleteRead carries a byte *count*, not the
    data), so there is nothing to recover at the requests layer. Drop to http.client,
    which hands back what actually arrived. Only the JNLP endpoint does this; the JAR
    downloads are well-formed, so they stay on requests.
    """
    parts = urlparse(url)
    path = parts.path or "/"
    if parts.query:
        path += "?" + parts.query
    headers = {"Accept": "*/*", "Connection": "close"}
    jar = "; ".join(f"{c.name}={c.value}" for c in session.cookies)
    if jar:
        headers["Cookie"] = jar
    if parts.scheme == "https":
        conn = http.client.HTTPSConnection(
            parts.hostname, parts.port or 443, timeout=timeout,
            context=ssl._create_unverified_context(),
        )
    else:
        conn = http.client.HTTPConnection(parts.hostname, parts.port or 80, timeout=timeout)
    try:
        conn.request("GET", path, headers=headers)
        resp = conn.getresponse()
        try:
            return resp.status, resp.read(), False
        except http.client.IncompleteRead as e:
            return resp.status, e.partial, True
    finally:
        conn.close()


def fetch_jnlp(session, base, explicit_path=None):
    paths = [explicit_path] if explicit_path else JNLP_CANDIDATES
    truncated_seen = False
    for path in paths:
        url = urljoin(base, path)
        try:
            r = session.get(url, timeout=20)
            status, body = r.status_code, r.content
        except requests.exceptions.ChunkedEncodingError:
            # Almost certainly the over-declared Content-Length above.
            try:
                status, body, short = tolerant_get(session, url)
            except (OSError, http.client.HTTPException) as e:
                log(f"  {path} -> {e}")
                continue
            if short:
                truncated_seen = True
                log(f"  {path} -> server cut the body short; using the {len(body)}B it sent")
        except requests.RequestException as e:
            log(f"  {path} -> {e}")
            continue
        text = body.decode("utf-8", "replace")
        # GoAhead answers unknown paths with 405, not 404. Content is the real test.
        if status == 200 and "<jnlp" in text.lower():
            log(f"got JNLP from {path}")
            return text
        log(f"  {path} -> HTTP {status}, {len(body)}B, not a JNLP")
    hint = ""
    if truncated_seen:
        hint = ("\nA candidate did return data but it was not a JNLP, so the endpoint "
                "is probably elsewhere on this firmware.")
    raise SystemExit(
        "could not locate the JNLP endpoint on this firmware." + hint + "\n"
        "Log into the web UI, click the console launch button, and pass the path you see "
        "with --jnlp-path (or hand the downloaded file to --jnlp)."
    )


# ---------------------------------------------------------------------------- jnlp

def parse_jnlp(xml_text, fallback_base=None):
    try:
        root = ElementTree.fromstring(xml_text)
    except ElementTree.ParseError as e:
        raise SystemExit(f"that is not a JNLP file (XML parse failed: {e})")
    codebase = root.get("codebase") or fallback_base
    if not codebase:
        raise SystemExit("JNLP has no codebase and none was supplied")
    if not codebase.endswith("/"):
        codebase += "/"

    jars, natives = [], []
    pack_enabled = False
    for res in root.findall("resources"):
        os_attr = (res.get("os") or "").lower()
        arch = (res.get("arch") or "").lower()
        # Unqualified <resources> applies to everyone; qualified ones must match Linux/x86_64.
        if os_attr and os_attr != "linux":
            continue
        if arch and arch not in NATIVE_ARCHES:
            continue
        for prop in res.findall("property"):
            if prop.get("name") == "jnlp.packEnabled":
                pack_enabled = prop.get("value", "").lower() == "true"
        for jar in res.findall("jar"):
            if jar.get("href") not in jars:
                jars.append(jar.get("href"))
        for nl in res.findall("nativelib"):
            # The same lib is usually listed under both x86_64 and amd64.
            if nl.get("href") not in natives:
                natives.append(nl.get("href"))

    args = [a.text or "" for a in root.findall("./application-desc/argument")]
    if not jars:
        raise SystemExit("JNLP lists no <jar> for this platform")
    if not args:
        raise SystemExit("JNLP has no <argument> list -- nothing to connect to")
    application = root.find("application-desc")
    main_class = application.get("main-class") or MAIN_CLASS
    return codebase, jars, natives, args, main_class, pack_enabled


def download(session, codebase, href, destdir, pack_enabled=False):
    url = urljoin(codebase, href)
    dest = os.path.join(destdir, os.path.basename(urlparse(href).path))
    candidates = [(url, False)]
    if pack_enabled:
        parts = urlparse(url)
        packed_url = parts._replace(path=parts.path + ".pack.gz").geturl()
        candidates.insert(0, (packed_url, True))
    for candidate, packed in candidates:
        try:
            r = session.get(candidate, timeout=60)
        except requests.RequestException as e:
            raise SystemExit(f"failed to download {candidate}: {e}")
        if packed and r.status_code in (404, 410):
            continue  # Web Start falls back to the plain JAR when packing is unavailable.
        if r.status_code != 200 or not r.content:
            raise SystemExit(f"failed to download {candidate} (HTTP {r.status_code})")
        if packed:
            unpack = shutil.which("unpack200")
            if not unpack:
                raise SystemExit("Pack200 JAR requires unpack200 (included in the Java 8 container)")
            packed_path = dest + ".pack.gz"
            try:
                with open(packed_path, "wb") as fh:
                    fh.write(r.content)
                subprocess.run([unpack, packed_path, dest], check=True, capture_output=True)
            except subprocess.CalledProcessError:
                raise SystemExit(f"failed to unpack {candidate}")
            finally:
                os.unlink(packed_path)
        else:
            with open(dest, "wb") as fh:
                fh.write(r.content)
        if not zipfile.is_zipfile(dest):
            os.unlink(dest)
            raise SystemExit(f"download from {candidate} is not a valid JAR")
        log(f"fetched {os.path.basename(dest)} ({len(r.content)}B{' Pack200' if packed else ''})")
        return dest


def extract_natives(jar_path, libdir):
    os.makedirs(libdir, exist_ok=True)
    n = 0
    with zipfile.ZipFile(jar_path) as z:
        for name in z.namelist():
            if name.endswith(".so"):
                with z.open(name) as src, open(os.path.join(libdir, os.path.basename(name)), "wb") as dst:
                    shutil.copyfileobj(src, dst)
                n += 1
    log(f"extracted {n} native lib(s) from {os.path.basename(jar_path)}")


# ---------------------------------------------------------------------------- main

def main():
    p = argparse.ArgumentParser(description="Launch AMI JViewer against a BMC")
    p.add_argument("--jnlp", help="path or URL of an existing .jnlp, or '-' to read it from stdin")
    p.add_argument("--host", default=os.environ.get("BMC_HOST"))
    p.add_argument("--user", default=os.environ.get("BMC_USER"))
    p.add_argument("--password", default=os.environ.get("BMC_PASS"))
    p.add_argument("--jnlp-path", default=os.environ.get("BMC_JNLP_PATH"),
                   help="override the JNLP endpoint path on the BMC")
    p.add_argument("--workdir", default="/tmp/jviewer")
    p.add_argument("--dump-only", action="store_true", help="resolve everything, print the command, do not exec")
    args = p.parse_args()

    session = bmc_session()
    base = None

    if args.jnlp:
        if args.jnlp == "-":
            # Uploaded by kvm-session. Kept off the filesystem: the tokens inside are
            # single-use, and a temp file would outlive the launch on any crash path.
            xml = sys.stdin.read()
            if not xml.strip():
                raise SystemExit("no JNLP arrived on stdin")
        elif urlparse(args.jnlp).scheme in ("http", "https"):
            try:
                r = session.get(args.jnlp, timeout=20)
                r.raise_for_status()
            except requests.RequestException as e:
                raise SystemExit(f"could not fetch {args.jnlp}: {e}")
            xml = r.text
            base = args.jnlp
        else:
            try:
                with open(args.jnlp) as fh:
                    xml = fh.read()
            except OSError as e:
                raise SystemExit(f"could not read {args.jnlp}: {e}")
    elif args.host and args.user and args.password is not None:
        session, base = bmc_login(args.host, args.user, args.password)
        xml = fetch_jnlp(session, base, args.jnlp_path)
    else:
        p.error("need --jnlp, or --host/--user/--password (or BMC_HOST/BMC_USER/BMC_PASS)")

    codebase, jars, natives, jargs, main_class, pack_enabled = parse_jnlp(xml, base)
    log(f"codebase={codebase}")
    log(f"main-class={main_class} args={len(jargs)}")

    workdir = args.workdir
    libdir = os.path.join(workdir, "lib")
    shutil.rmtree(workdir, ignore_errors=True)
    os.makedirs(libdir, exist_ok=True)

    classpath = [download(session, codebase, j, workdir, pack_enabled) for j in jars]
    for nl in natives:
        extract_natives(download(session, codebase, nl, workdir, pack_enabled), libdir)

    cmd = [
        "java",
        f"-Djava.library.path={libdir}",
        # JViewer predates HiDPI/GTK LAF autodetection; force the safe combination.
        "-Dsun.java2d.opengl=false",
        "-Dawt.useSystemAAFontSettings=on",
        "-cp", ":".join(classpath),
        main_class,
    ] + jargs

    # Token positions differ between AMI and ATEN viewers; redact every argument.
    log("exec: " + " ".join(cmd[:-len(jargs)] + ["<redacted arguments>"]))
    if args.dump_only:
        print("\0".join(cmd))
        return
    os.chdir(workdir)
    os.execvp(cmd[0], cmd)


if __name__ == "__main__":
    main()
