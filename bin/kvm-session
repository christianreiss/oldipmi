#!/usr/bin/env python3
"""
Own the JViewer process so it can be started, stopped and restarted from a browser.

Bound to loopback and never published: bin/kvm-web is the only thing that talks to it.
It exists as a separate process because websockify hands every connection to a fresh
interpreter (python 3.14 defaults multiprocessing to `forkserver`), so nothing that has
to outlive a single request can live in the web layer.
"""
import argparse, collections, json, os, shutil, signal, subprocess, sys, threading, time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

WORKROOT = "/tmp/jviewer"
# JViewer is a Swing app talking a proprietary protocol; there is no ready signal to
# wait for. Staying alive this long past exec is the best "it got somewhere" we have.
CONNECT_GRACE = 8.0
MAX_BODY = 512 * 1024


def log(msg):
    print(f"[kvm-session] {msg}", file=sys.stderr, flush=True)


class Launcher:
    """One JViewer at a time. MegaRAC allows very few concurrent iKVM sessions, so a
    new launch must kill the old one and reap it before starting."""

    def __init__(self):
        self._lock = threading.RLock()
        self._proc = None
        self._seq = 0
        self.state = "idle"        # idle | starting | running | stopped | failed
        self.detail = ""
        self.target = ""
        self.error = ""
        self.since = time.time()
        self._exec_at = 0.0
        self.log = collections.deque(maxlen=200)

    # ---------------------------------------------------------------- public API

    def status(self):
        with self._lock:
            return {
                "state": self.state,
                "detail": self.detail,
                "target": self.target,
                "error": self.error,
                "since": self.since,
                "log": list(self.log)[-40:],
            }

    def connect(self, spec):
        """spec: {'mode': 'bmc'|'jnlp'|'env'|'argv', ...}. Returns a status dict."""
        mode = spec.get("mode")
        env = os.environ.copy()
        argv = []
        stdin_data = None

        if mode == "bmc":
            host = (spec.get("host") or "").strip()
            user = (spec.get("user") or "").strip()
            password = spec.get("password") or ""
            if not host or not user:
                raise ValueError("host and user are required")
            # Through the environment rather than argv so it stays out of `ps`.
            # jviewer-launch already defaults --host/--user/--password from these.
            env["BMC_HOST"], env["BMC_USER"], env["BMC_PASS"] = host, user, password
            jnlp_path = (spec.get("jnlp_path") or "").strip()
            if jnlp_path:
                env["BMC_JNLP_PATH"] = jnlp_path
            else:
                env.pop("BMC_JNLP_PATH", None)
            target = f"{user}@{host}"

        elif mode == "jnlp":
            xml = spec.get("xml") or ""
            if "<jnlp" not in xml.lower():
                raise ValueError("that does not look like a .jnlp file")
            # Down the child's stdin: the tokens inside are single-use and a temp file
            # would outlive the launch on every crash path.
            argv = ["--jnlp", "-"]
            stdin_data = xml
            target = "dropped JNLP"

        elif mode == "env":
            for k in ("BMC_HOST", "BMC_USER", "BMC_PASS"):
                if not env.get(k):
                    raise ValueError("this container has no BMC credentials configured")
            target = f"{env['BMC_USER']}@{env['BMC_HOST']}"

        elif mode == "argv":
            # Boot-time autoconnect: whatever the container was started with, verbatim.
            argv = list(spec.get("argv") or [])
            if any(a == "--jnlp" or a.startswith("--jnlp=") for a in argv):
                target = "JNLP passed to the container"
            elif env.get("BMC_HOST"):
                target = f"{env.get('BMC_USER', '?')}@{env['BMC_HOST']}"
            else:
                target = "container arguments"

        else:
            raise ValueError(f"unknown mode {mode!r}")

        return self._spawn(argv, env, target, stdin_data)

    def disconnect(self):
        with self._lock:
            self._stop_locked()
            self.state, self.detail, self.error = "idle", "", ""
            self.since = time.time()
            self.log.clear()
            return self.status()

    def shutdown(self):
        with self._lock:
            self._stop_locked()

    # ------------------------------------------------------------------ internals

    def _spawn(self, argv, env, target, stdin_data):
        with self._lock:
            self._stop_locked()
            self._seq += 1
            # jviewer-launch rmtree's its workdir on every run, and workdir/lib holds the
            # .so files the running JVM has dlopen'ed. A per-launch directory makes it
            # impossible for a relaunch to pull them out from under a live process.
            workdir = os.path.join(WORKROOT, str(self._seq))
            self._prune(keep=workdir)
            cmd = ["jviewer-launch", "--workdir", workdir] + argv
            log(f"launching: {' '.join(cmd)}  target={target}")
            try:
                proc = subprocess.Popen(
                    cmd, env=env,
                    stdin=subprocess.PIPE if stdin_data else subprocess.DEVNULL,
                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                    text=True, bufsize=1,
                )
            except OSError as e:
                self.state, self.error, self.detail = "failed", str(e), ""
                self.since = time.time()
                return self.status()

            self._proc = proc
            self.state, self.target, self.error = "starting", target, ""
            self.detail = "contacting the BMC"
            self.since = time.time()
            self._exec_at = 0.0
            self.log.clear()

        if stdin_data:
            try:
                proc.stdin.write(stdin_data)
                proc.stdin.close()
            except OSError:
                pass  # child already gone; the watcher reports why

        threading.Thread(target=self._watch, args=(proc,), daemon=True).start()
        return self.status()

    def _watch(self, proc):
        """Read the child's output and turn it into state.

        jviewer-launch logs `exec: ...` immediately before os.execvp. That line is the
        boundary: everything before it is jviewer-launch's own diagnosis (bad password,
        no JNLP endpoint, download failure) and is a real answer; everything after it is
        java's output, and a failure there means the console started and then stopped --
        not that the login was wrong.
        """
        for line in proc.stdout:
            line = line.rstrip("\n")
            if not line:
                continue
            with self._lock:
                if proc is not self._proc:
                    return  # superseded by a newer launch
                self.log.append(line)
                if "] exec: " in line:
                    self._exec_at = time.time()
                    self.detail = "starting the console"
                elif "logged in to" in line:
                    self.detail = "logged in, fetching the JNLP"
                elif "got JNLP from" in line:
                    self.detail = "downloading the viewer"
                elif line.startswith("[jviewer] fetched"):
                    self.detail = "downloading the viewer"

        # stdout closed -> the process is on its way out, or already gone.
        rc = proc.wait()
        with self._lock:
            if proc is not self._proc:
                return
            self._proc = None
            self.since = time.time()
            self.detail = ""
            tail = next((l for l in reversed(self.log) if l.strip()), "")
            exec_at = self._exec_at
            if not exec_at:
                self.state = "failed"
                self.error = tail or f"jviewer-launch exited with status {rc}"
            elif time.time() - exec_at < CONNECT_GRACE:
                self.state = "failed"
                self.error = (
                    f"the console started, then exited immediately (status {rc}). "
                    "If this was a re-used .jnlp its token is spent -- fetch a fresh one, "
                    "or connect with credentials instead."
                )
            else:
                self.state = "stopped"
                self.error = ""
        log(f"child exited rc={rc} reached_exec={bool(exec_at)} -> {self.state}")

    def _promote(self):
        """Called from the poll loop: flip starting -> running once java has survived."""
        with self._lock:
            p = self._proc
            if p is None or self.state != "starting":
                return
            if p.poll() is not None:
                return
            # Measured from exec, not from spawn: the work before exec is unbounded.
            if self._exec_at and time.time() - self._exec_at > CONNECT_GRACE:
                self.state = "running"
                self.detail = ""

    def _stop_locked(self):
        p = self._proc
        self._proc = None
        if p is None or p.poll() is not None:
            return
        # jviewer-launch execvp's into java, so this pid IS the JVM. Killing it closes
        # the TCP sessions, which is what may let the BMC release its iKVM slot.
        log(f"stopping pid {p.pid}")
        try:
            p.terminate()
        except OSError:
            pass
        try:
            p.wait(timeout=6)
        except subprocess.TimeoutExpired:
            log(f"pid {p.pid} ignored SIGTERM; killing")
            try:
                p.kill()
            except OSError:
                pass
            try:
                p.wait(timeout=3)
            except subprocess.TimeoutExpired:
                pass

    @staticmethod
    def _prune(keep):
        try:
            names = os.listdir(WORKROOT)
        except OSError:
            return
        for name in names:
            path = os.path.join(WORKROOT, name)
            if path != keep:
                shutil.rmtree(path, ignore_errors=True)


LAUNCHER = Launcher()


def defaults():
    return {
        "host": os.environ.get("BMC_HOST", ""),
        "user": os.environ.get("BMC_USER", ""),
        "jnlp_path": os.environ.get("BMC_JNLP_PATH", ""),
        "has_env_credentials": all(
            os.environ.get(k) for k in ("BMC_HOST", "BMC_USER", "BMC_PASS")
        ),
    }


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "kvm-session/1"

    def log_message(self, fmt, *a):
        pass  # the interesting logging is Launcher's

    def _send(self, obj, code=200):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _body(self):
        n = int(self.headers.get("Content-Length") or 0)
        if n <= 0:
            return {}
        if n > MAX_BODY:
            raise ValueError("request body too large")
        raw = self.rfile.read(n)
        try:
            return json.loads(raw)
        except ValueError:
            raise ValueError("malformed JSON body")

    def do_GET(self):
        if self.path.rstrip("/") in ("/status", ""):
            st = LAUNCHER.status()
            st["defaults"] = defaults()
            return self._send(st)
        self._send({"error": "not found"}, 404)

    def do_POST(self):
        try:
            spec = self._body()
        except ValueError as e:
            return self._send({"error": str(e)}, 400)
        path = self.path.rstrip("/")
        try:
            if path == "/connect":
                LAUNCHER._promote()
                return self._send(LAUNCHER.connect(spec))
            if path == "/disconnect":
                return self._send(LAUNCHER.disconnect())
        except ValueError as e:
            return self._send({"error": str(e)}, 400)
        except Exception as e:                      # noqa: BLE001 - surface it, don't 500 blindly
            log(f"connect failed: {e!r}")
            return self._send({"error": f"{type(e).__name__}: {e}"}, 500)
        self._send({"error": "not found"}, 404)


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


def main():
    p = argparse.ArgumentParser(description="Supervise JViewer for kvm-web")
    p.add_argument("--listen", default="127.0.0.1")
    p.add_argument("--port", type=int, default=int(os.environ.get("SESSION_PORT", "8081")))
    p.add_argument("--no-autoconnect", action="store_true")
    args, passthrough = p.parse_known_args()

    httpd = Server((args.listen, args.port), Handler)
    threading.Thread(target=httpd.serve_forever, kwargs={"poll_interval": 0.5},
                     daemon=True).start()
    log(f"listening on {args.listen}:{args.port}")

    # serve_forever() runs on its own thread so the main thread stays free to take the
    # signal. That matters: this handler is the only thing that kills java on `docker
    # stop`, and the BMC keeps its iKVM slot until those TCP sessions close.
    stopping = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stopping.set())
    signal.signal(signal.SIGINT, lambda *_: stopping.set())

    if not args.no_autoconnect:
        d = defaults()
        try:
            if any(a == "--jnlp" or a.startswith("--jnlp=") for a in passthrough):
                LAUNCHER.connect({"mode": "argv", "argv": passthrough})
            elif d["has_env_credentials"]:
                LAUNCHER.connect({"mode": "argv", "argv": passthrough})
            else:
                log("no --jnlp and no BMC credentials -- waiting for a browser")
        except Exception as e:                      # noqa: BLE001
            log(f"autoconnect failed: {e!r}")

    while not stopping.wait(1.0):
        LAUNCHER._promote()

    log("shutting down")
    LAUNCHER.shutdown()
    httpd.shutdown()


if __name__ == "__main__":   # required: py3.14 multiprocessing defaults to forkserver
    main()
